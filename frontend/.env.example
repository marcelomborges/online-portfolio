# Server-side proxy target (Docker Compose service name or localhost)
NUXT_API_INTERNAL_BASE=http://localhost:8080

# Browser uses Nuxt BFF — never call Render directly from the client
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_PLATFORM_HOST=onlineportfolio.com.br
NUXT_PUBLIC_APP_HOST=app.onlineportfolio.com.br

# -----------------------------------------------------------------------------
# Local dev — simula qual "host" a app está servindo (localhost não tem subdomínio).
# Em produção isso vem do Host real (ana.onlineportfolio.com.br, app.*, etc.).
# Reinicie `npm run dev` após alterar estas variáveis.
# -----------------------------------------------------------------------------

# NUXT_PUBLIC_DEV_SURFACE — qual superfície da UI renderizar:
#
#   dev       → Skeleton do projeto (painel de config, layout default).
#               Equivale a "ainda não simulei um host de produção".
#
#   tenant    → Site público de um cliente/artista ({slug}.onlineportfolio.com.br).
#               Usa layout tenant + tema CSS + componentes em
#               components/public/tenants/{slug}/ (fallback: shared/).
#               Requer NUXT_PUBLIC_DEV_TENANT_SLUG abaixo.
#
#   platform  → Landing da plataforma (onlineportfolio.com.br — marketing do produto).
#               Não é site de artista; é a página de venda do SaaS.
#
#   app       → Admin + login padronizado (app.onlineportfolio.com.br).
#               Mesma UI para todos os tenants; permissões vêm do usuário logado
#               (/auth/me), não do slug. Dark mode fixo (surface-app). Teste /login.
#
NUXT_PUBLIC_DEV_SURFACE=dev

# Slug do tenant — só usado quando DEV_SURFACE=tenant.
# Exemplos no repo: ana, joao. Novo cliente: maria (ver docs/FRONTEND_COMPONENTS.md).
NUXT_PUBLIC_DEV_TENANT_SLUG=ana
