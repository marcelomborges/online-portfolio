# Runtime (Supabase pooler in prod — local Compose in DEV-002)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=portfolio_dev;Username=portfolio;Password=portfolio_dev

# Migrations only — direct connection (CI / local dotnet ef). Supabase prod: direct :5432, not pooler :6543
ConnectionStrings__Migration=Host=localhost;Port=5432;Database=portfolio_dev;Username=portfolio;Password=portfolio_dev

# JWT (API-issued — DEV-153)
Jwt__Secret=change-me-min-32-chars-for-dev-only
Jwt__Issuer=OnlinePortfolio.Api
Jwt__Audience=OnlinePortfolio.Admin

# SendGrid (DEV-014 / DEV-107)
SendGrid__ApiKey=
SendGrid__FromEmail=noreply@onlineportfolio.com.br
SendGrid__FromName=Online Portfolio

# Supabase Storage (Phase 3+)
Supabase__Url=
Supabase__ServiceRoleKey=

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
